{
  "name": "cordoval-os",
  "private": true,
  "version": "1.0.0",
  "description": "Cordoval OS - The Local First OS for Business Builders",
  "author": {
    "name": "Kieren Day",
    "email": "kiere.day@cordoval.com"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/KierenDayStudios/Cordoval-OS-Official.git"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:publish": "npm run build && electron-builder --publish always",
    "postinstall": "node -e \"try { require('fs').mkdirSync('dist', { recursive: true }); } catch {}\""
  },
  "dependencies": {
    "@google/genai": "^1.38.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/express": "^5.0.6",
    "@types/papaparse": "^5.5.2",
    "@vercel/analytics": "^2.0.0",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "fabric": "5.3.0",
    "fast-xml-parser": "^5.10.1",
    "firebase": "^12.13.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "marked": "^12.0.0",
    "motion": "^12.34.3",
    "p-retry": "^8.0.0",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.6.205",
    "pixi.js": "7.4.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "recharts": "^3.8.1",
    "sortablejs": "1.15.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react-signature-canvas": "^1.0.7",
    "@vercel/node": "^5.7.12",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  },
  "build": {
    "appId": "com.cordoval.os",
    "productName": "Cordoval OS",
    "copyright": "Copyright © 2026 Cordoval",
    "directories": {
      "output": "release",
      "buildResources": "electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "public/**/*"
    ],
    "extraResources": [
      {
        "from": "electron",
        "to": "electron",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "artifactName": "Cordoval-OS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cordoval OS",
      "uninstallDisplayName": "Cordoval OS",
      "license": "LICENSE.txt"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "artifactName": "Cordoval-OS-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "artifactName": "Cordoval-OS-${version}.${ext}",
      "category": "Office",
      "synopsis": "Cordoval OS - The Local First OS for Business Builders"
    },
    "publish": {
      "provider": "github",
      "owner": "KierenDayStudios",
      "repo": "Cordoval-OS-Official",
      "releaseType": "release"
    },
    "asar": true,
    "compression": "maximum"
  }
}
